{
  "AuthServer": {
    "Authority": "https://localhost:7010/",
    "Audience": "carrental-api",
    "RequireHttpsMetadata": true,
    "ValidateAudience": true,
    "ClockSkewSeconds": 60
  },
  "ConnectionStrings": {
    "CarRentalApi": "CarRentalDb01.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "CarRentalApi.Domain": "Debug",
      "CarRentalApi.Data": "Debug"
    }
  },
  "AllowedHosts": "*"
}
